{
  "name": "esale-frontend",
  "version": "1.0.0",
  "description": "Electronics E-commerce Platform Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd ../backend && uvicorn app.main:app --reload",
    "dev:all": "concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"cd ../backend && uvicorn app.main:app --reload\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx",
    "lint:fix": "eslint src --ext js,jsx --fix"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "axios": "^1.6.2",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "vite": "^5.0.8"
  }
}
